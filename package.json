{
  "name": "pracht-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "verify": "node ./scripts/verify.mjs",
    "typecheck": "node ./scripts/typecheck.mjs",
    "test": "vitest run",
    "prepare": "playwright install chromium",
    "pracht": "node ./packages/cli/bin/pracht.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node ./scripts/build.mjs --force && changeset publish",
    "e2e": "playwright test",
    "bench": "node ./bench/run.mjs",
    "bench:check": "node ./bench/run.mjs --bytes-only --check",
    "dev:example": "cd examples/cloudflare && node ../../packages/cli/bin/pracht.js dev",
    "build:example": "cd examples/cloudflare && node ../../packages/cli/bin/pracht.js build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "jsdom": "^29.0.2",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "preact": "^10.26.9",
    "preact-render-to-string": "^6.5.13",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
