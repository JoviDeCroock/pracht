{
  "name": "notes agent flow over MCP",
  "task": "The same notes task an MCP host would run: initialize, search, hit a validation failure as a tool error, create a note, then prepare and commit its destructive purge — every step a tools/call against /mcp.",
  "transport": "mcp",
  "steps": [
    {
      "capability": "notes.search",
      "input": { "query": "capabilities" },
      "expect": { "ok": true, "status": 200 }
    },
    {
      "capability": "notes.search",
      "input": { "query": "" },
      "expect": { "ok": false, "status": 400, "errorCode": "invalid_input" }
    },
    {
      "capability": "notes.create",
      "input": {
        "title": "MCP purge target (created over MCP)",
        "body": "Created by pracht eval over tools/call."
      },
      "expect": {
        "ok": true,
        "status": 200,
        "output": { "note": { "title": "MCP purge target (created over MCP)" } }
      }
    },
    {
      "capability": "notes.purge",
      "input": { "titlePrefix": "MCP purge target" },
      "expect": { "ok": false, "status": 409, "errorCode": "confirmation_required" }
    },
    {
      "capability": "notes.purge",
      "input": { "titlePrefix": "MCP purge target" },
      "confirm": "$steps[3].error.confirmationToken",
      "expect": { "ok": true, "status": 200 }
    }
  ]
}
