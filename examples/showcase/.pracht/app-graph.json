    {
      "agentPolicy": null,
      "description": "Create a new Launchpad project. The project starts in the 'building' status.",
      "effect": "write",
      "hasUi": false,
      "httpPath": "/api/capabilities/projects/create",
      "input": {
        "type": "object",
        "properties": {
          "name": {
