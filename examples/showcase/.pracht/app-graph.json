    {
      "agentPolicy": null,
      "description": "Find Launchpad projects by name or summary. Returns id, name, status, environment and deploy count.",
      "effect": "read",
      "hasUi": false,
      "httpPath": "/api/capabilities/projects/search",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 120,
            "default": "",
            "description": "Free text matched against project name and summary. Empty matches all."
