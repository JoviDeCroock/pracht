    },
    {
      "agentPolicy": null,
      "description": "Ship the current build of a project. Pass a stable idempotencyKey to make retries safe.",
      "effect": "write",
      "hasUi": false,
      "httpPath": "/api/capabilities/projects/deploy",
      "input": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "description": "Project id from projects.search."
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 80,
            "description": "Repeat the same key to retry without deploying twice."
          }
