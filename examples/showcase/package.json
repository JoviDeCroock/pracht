{
  "name": "@pracht/example-showcase",
  "version": "0.0.21",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PRACHT_CONFIRMATION_SECRET=${PRACHT_CONFIRMATION_SECRET:-showcase-dev-confirmation-secret} pracht dev",
    "build": "pracht build",
    "preview": "PRACHT_CONFIRMATION_SECRET=${PRACHT_CONFIRMATION_SECRET:-showcase-dev-confirmation-secret} pracht preview",
    "typegen": "pracht typegen",
    "verify": "PRACHT_CONFIRMATION_SECRET=${PRACHT_CONFIRMATION_SECRET:-showcase-dev-confirmation-secret} pracht verify",
    "plan": "pracht plan",
    "snapshot": "pracht plan --write",
    "inspect": "pracht inspect capabilities",
    "eval": "PRACHT_CONFIRMATION_SECRET=${PRACHT_CONFIRMATION_SECRET:-showcase-dev-confirmation-secret} pracht eval --start \"pracht dev --port 5183\" --url http://localhost:5183",
    "agent": "node scripts/agent.mjs"
  },
  "dependencies": {
    "@pracht/adapter-vercel": "workspace:*",
    "@pracht/capabilities": "workspace:*",
    "@pracht/core": "workspace:*"
  },
  "devDependencies": {
    "@pracht/cli": "workspace:*",
    "@pracht/vite-plugin": "workspace:*",
    "preact": "^10.26.9",
    "preact-render-to-string": "^6.5.13",
    "vite": "^8.0.0"
  }
}
