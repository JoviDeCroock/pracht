{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@pracht/core": ["./packages/framework/src/index.ts"],
      "@pracht/core/browser": ["./packages/framework/src/browser.ts"],
      "@pracht/core/client": ["./packages/framework/src/client.ts"],
      "@pracht/core/manifest": ["./packages/framework/src/manifest.ts"],
      "@pracht/core/env": ["./packages/framework/src/env.ts"],
      "@pracht/core/env/server": ["./packages/framework/src/env-server.ts"],
      "@pracht/core/server": ["./packages/framework/src/server.ts"],
      "@pracht/core/islands-client": ["./packages/framework/src/islands-client.ts"],
      "@pracht/capabilities": ["./packages/capabilities/src/index.ts"],
      "@pracht/openapi": ["./packages/openapi/src/index.ts"],
      "@pracht/openapi/vite": ["./packages/openapi/src/vite.ts"],
      "@pracht/vite-plugin": ["./packages/vite-plugin/src/index.ts"],
      "@pracht/preact-ssr-precompile": ["./packages/preact-ssr-precompile/src/index.ts"],
      "@pracht/adapter-node": ["./packages/adapter-node/src/index.ts"],
      "@pracht/adapter-cloudflare": ["./packages/adapter-cloudflare/src/index.ts"],
      "@pracht/adapter-netlify": ["./packages/adapter-netlify/src/index.ts"],
      "@pracht/adapter-vercel": ["./packages/adapter-vercel/src/index.ts"],
      "@pracht/image": ["./packages/image/src/index.ts"],
      "@pracht/image/node": ["./packages/image/src/node.ts"],
      "@pracht/image/vite": ["./packages/image/src/vite.ts"],
      "@pracht/i18n": ["./packages/i18n/src/index.ts"],
      "@pracht/test": ["./packages/test/src/index.ts"]
    }
  },
  // Generated route registrations and ambient platform modules are global to
  // a TypeScript program. Basic's route declaration stays in its own program,
  // and the Cloudflare CLI fixture is checked by its local tsconfig so its
  // cloudflare:workers declaration cannot merge with the example's types.
  "exclude": [
    "examples/showcase",
    "examples/basic/src/pracht.d.ts",
    "packages/cli/test/fixtures/cloudflare-runtime-import"
  ],
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/vite-plugin/virtual.d.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "e2e/**/*.ts"
  ]
}
