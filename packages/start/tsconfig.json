// create-pracht ships plain JavaScript; this program type-checks it from its
// JSDoc (run by `pnpm typecheck`, see scripts/typecheck.mjs). Every strict
// check is on except `noImplicitAny`: most parameters carry no annotation yet,
// and turning it on is the next step once they do.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src/**/*.js", "bin/**/*.js", "scripts/**/*.js"]
}
