{
  "name": "@pracht/session",
  "version": "0.0.0",
  "description": "First-party sessions for Pracht: encrypted cookie sessions or store-backed session ids, secret rotation, flash messages, and session middleware. WebCrypto only, so it runs unchanged on Node, Cloudflare Workers, Netlify, and Vercel.",
  "keywords": [
    "pracht",
    "preact",
    "session",
    "cookie",
    "auth",
    "authentication",
    "webcrypto",
    "aes-gcm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JoviDeCroock/pracht/tree/main/packages/session",
  "bugs": {
    "url": "https://github.com/JoviDeCroock/pracht/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoviDeCroock/pracht",
    "directory": "packages/session"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@pracht/core": "workspace:*"
  }
}
